# ============================================
# FunASR + Qwen + Piper 语音助手配置
# ============================================
# 复制此文件为 .env 并填写配置
# cp .env.example .env

# ============================================
# Qwen 配置 (必填)
# ============================================

# 阿里云百炼平台 API Key
# 获取地址: https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-your-api-key-here

# 模型选择 (可选，默认 qwen-plus)
# 可选: qwen-turbo, qwen-plus, qwen-max
QWEN_MODEL=qwen-plus

# API 地址 (可选)
# 国际版: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内版: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ============================================
# FunASR 配置 (可选)
# ============================================

# STT 模型 (可选，默认 iic/SenseVoiceSmall)
# 可选: iic/SenseVoiceSmall, iic/SenseVoiceLarge
FUNASR_MODEL=iic/SenseVoiceSmall

# 语言 (可选，默认 auto)
# 可选: zh, en, ja, ko, auto
FUNASR_LANGUAGE=zh

# HuggingFace 镜像 (如果下载慢)
# HF_ENDPOINT=https://hf-mirror.com

# ============================================
# Piper 配置 (可选)
# ============================================

# 语音选择 (可选，默认 zh_CN-huayan-medium)
# 中文语音:
#   - zh_CN-huayan-medium: 女声，中等质量 (推荐)
#   - zh_CN-huayan-x_low: 女声，低质量，快速
# 英文语音:
#   - en_US-ryan-high: 男声
#   - en_US-amy-high: 女声
PIPER_VOICE=zh_CN-huayan-medium

# 语速 (可选，默认 1.0)
# < 1.0: 更快
# > 1.0: 更慢
PIPER_LENGTH_SCALE=1.0

# ============================================
# 系统提示词 (可选)
# ============================================

# 自定义系统提示词
# SYSTEM_PROMPT=你是一个友好的中文语音助手。请用简洁、自然的中文回答用户问题。
